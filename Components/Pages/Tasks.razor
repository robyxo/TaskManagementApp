@inherits ViewModelPageBase<TasksViewModel>
@rendermode InteractiveServer

<PageTitle>@VM.Title - Task Management</PageTitle>

@* 1. Page title with the "new task" button *@
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="display-6 mb-0">@VM.Title</h1>
    <button class="btn btn-primary" @onclick="VM.OpenCreateForm">
        <i class="bi bi-plus-lg"></i> New task
    </button>
</div>

@* 2. Error and success messages *@
@if (!string.IsNullOrEmpty(VM.ErrorMessage))
{
    <div class="alert alert-danger">@VM.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(VM.SuccessMessage))
{
    <div class="alert alert-success">@VM.SuccessMessage</div>
}

@* 3. Create / edit form *@
@if (VM.SelectedTask is not null)
{
    <div class="card border-primary mb-4">
        <div class="card-header bg-primary text-white">
            @(VM.IsEditing ? "Edit task" : "New task")
        </div>
        <div class="card-body">
            <EditForm Model="EditingTask" OnValidSubmit="VM.SaveTaskAsync">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Title</label>
                        <InputText class="form-control" @bind-Value="EditingTask.Title" />
                        <ValidationMessage For="() => EditingTask.Title" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <InputSelect class="form-select" @bind-Value="EditingTask.CategoryId">
                            <option value="0">-- Select --</option>
                            @foreach (var category in VM.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => EditingTask.CategoryId" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Priority</label>
                        <InputSelect class="form-select" @bind-Value="EditingTask.Priority">
                            @foreach (var priority in AllPriorities)
                            {
                                <option value="@priority">@TaskDisplay.PriorityLabel(priority)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <InputSelect class="form-select" @bind-Value="EditingTask.Status">
                            @foreach (var status in AllStatuses)
                            {
                                <option value="@status">@TaskDisplay.StatusLabel(status)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Due date</label>
                        <InputDate class="form-control" @bind-Value="EditingTask.DueDate" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="EditingTask.Description" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg"></i> Save
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="VM.CloseForm">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* 4. Filters *@
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Search</label>
                <input type="text" class="form-control" placeholder="Title or description..."
                       @bind="VM.SearchText" @bind:event="oninput" @bind:after="VM.LoadAsync" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select class="form-select" @onchange="OnStatusFilterChanged">
                    <option value="">All statuses</option>
                    @foreach (var status in AllStatuses)
                    {
                        <option value="@status">@TaskDisplay.StatusLabel(status)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Priority</label>
                <select class="form-select" @onchange="OnPriorityFilterChanged">
                    <option value="">All priorities</option>
                    @foreach (var priority in AllPriorities)
                    {
                        <option value="@priority">@TaskDisplay.PriorityLabel(priority)</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

@* 5. Spinner or tasks table *@
@if (VM.IsLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (VM.Tasks.Any())
{
    <div class="table-card table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Due</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in VM.Tasks)
                {
                    <tr>
                        <td>
                            <strong>@task.Title</strong>
                            @if (!string.IsNullOrEmpty(task.Description))
                            {
                                <br />
                                <small class="text-muted">@ShortDescription(task.Description)</small>
                            }
                        </td>
                        <td>
                            @if (task.Category is not null)
                            {
                                <span class="badge" style="background-color: @task.Category.Color;">@task.Category.Name</span>
                            }
                        </td>
                        <td><span class="badge @TaskDisplay.PriorityBadge(task.Priority)">@TaskDisplay.PriorityLabel(task.Priority)</span></td>
                        <td><span class="badge @TaskDisplay.StatusBadge(task.Status)">@TaskDisplay.StatusLabel(task.Status)</span></td>
                        <td>
                            @if (task.DueDate.HasValue)
                            {
                                <small>@TaskDisplay.DueDate(task.DueDate.Value)</small>
                            }
                            else
                            {
                                <small class="text-muted">—</small>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-primary" title="Edit" @onclick="() => VM.OpenEditForm(task)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" title="Delete" @onclick="() => ConfirmDeleteAsync(task)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info text-center py-5">
        <h4>No tasks found</h4>
        <p class="mb-0">Create your first task or change the filters.</p>
    </div>
}
