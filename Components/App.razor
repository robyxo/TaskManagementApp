@* 1. Root HTML document of the application: CSS, Blazor script and the Router *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    @* 2. Bootstrap and Bootstrap Icons from a CDN, so no NuGet packages are needed *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="app.css" />

    <HeadOutlet />
</head>
<body>
    @* 3. The Router picks the page to show based on the URL *@
    <Routes />

    @* 4. Blazor script: it opens the SignalR connection used by InteractiveServer pages *@
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
